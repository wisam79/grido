{
  "name": "frontend",
  "private": true,
  "version": "1.9.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/ensure-bindings.mjs && node scripts/copy-models.mjs",
    "prebuild:dev": "node scripts/ensure-bindings.mjs && node scripts/copy-models.mjs",
    "pretypecheck": "node scripts/ensure-bindings.mjs",
    "postinstall": "node scripts/copy-models.mjs",
    "models:sync": "node scripts/copy-models.mjs",
    "pretest": "node scripts/ensure-bindings.mjs",
    "pretest:coverage": "node scripts/ensure-bindings.mjs",
    "build": "tsc && vite build",
    "build:dev": "vite build",
    "preview": "vite preview",
    "prepare": "node ../scripts/setup-husky.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:print": "vitest run print cut-lines single-print",
    "test:canvas": "vitest run canvas konva element-geometry units",
    "test:store": "vitest run slice editor-store",
    "test:scanner": "vitest run document-scanner perspective-transform",
    "test:ipc": "vitest run ipc-contract-drift",
    "test:components": "vitest run test/*.test.tsx",
    "test:e2e": "playwright test",
    "test:e2e:fast": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test --update-snapshots",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:e2e:fast",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test e2e --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\""
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --report-unused-disable-directives --max-warnings 0",
      "prettier --write"
    ],
    "test/**/*.{ts,tsx}": [
      "eslint --report-unused-disable-directives --max-warnings 0",
      "prettier --write"
    ],
    "src/**/*.{css,md}": [
      "prettier --write"
    ],
    "e2e/**/*.ts": [
      "eslint --report-unused-disable-directives --max-warnings 0",
      "prettier --write"
    ],
    "playwright.config.ts": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fluentui/react-icons": "^2.0.341",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@techstark/opencv-js": "~5.0.0-release.1",
    "@types/jsbarcode": "^3.11.4",
    "@wailsio/runtime": "^3.0.0-beta.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "culori": "^4.0.2",
    "exifr": "^7.1.3",
    "framer-motion": "^12.23.2",
    "jsbarcode": "^3.12.3",
    "konva": "^10.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-colorful": "^5.7.0",
    "react-cropper": "^2.3.3",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "react-konva": "^19.2.5",
    "scanic": "~1.6.0",
    "scanic-ml": "~0.2.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.5",
    "zod": "^4.0.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/culori": "^4.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.23",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  }
}
