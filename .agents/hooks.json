{
  "grido-safety-and-startup": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/agent-hook-pre-command.mjs",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "node ../scripts/agent-hook-session-start.mjs",
        "timeout": 10
      }
    ]
  }
}
