{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grido.invalid/schemas/acceptance-manifest-v1.json",
  "title": "Scoped Grido acceptance evidence; never whole-application certification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "lane", "project", "shard", "fixtureKind", "timestamp", "environment", "fixtures", "binary", "inventory", "counts", "evidencePolicy", "execution", "evidence", "blockedCapabilities", "wholeApplicationAcceptance", "scopedGate", "failures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["sha", "ref", "runId", "attempt"],
      "properties": { "sha": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" }, "ref": { "type": "string" }, "runId": { "type": "string" }, "attempt": { "type": "string" } }
    },
    "lane": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "project": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "shard": { "type": "object", "additionalProperties": false, "required": ["index", "total"], "properties": { "index": { "type": "integer", "minimum": 1 }, "total": { "type": "integer", "minimum": 1, "maximum": 16 } } },
    "fixtureKind": { "enum": ["mocked-wails", "actual-local-supabase", "native-third-party-contract"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "environment": { "type": "object", "additionalProperties": false, "required": ["os", "arch", "image", "imageVersion", "node", "go", "playwright"], "properties": { "os": { "type": "string" }, "arch": { "type": "string" }, "image": { "type": "string" }, "imageVersion": { "type": "string" }, "node": { "type": "string" }, "go": { "type": "string" }, "playwright": { "type": "string" } } },
    "fixtures": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/hash" } } } },
    "binary": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["sha256", "publishable"], "properties": { "sha256": { "$ref": "#/$defs/hash" }, "publishable": { "const": false } } }] },
    "inventory": { "type": "object", "additionalProperties": false, "required": ["full", "selected", "fullHash", "selectedHash", "requiredCases"], "properties": { "full": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/test" } }, "selected": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/test" } }, "fullHash": { "$ref": "#/$defs/hash" }, "selectedHash": { "$ref": "#/$defs/hash" }, "requiredCases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } },
    "counts": { "type": "object", "additionalProperties": false, "required": ["expectedProject", "expectedShard", "executed", "passed", "skipped", "retried"], "properties": { "expectedProject": { "type": "integer", "minimum": 1 }, "expectedShard": { "type": "integer", "minimum": 1 }, "executed": { "type": "integer", "minimum": 0 }, "passed": { "type": "integer", "minimum": 0 }, "skipped": { "const": 0 }, "retried": { "const": 0 } } },
    "evidencePolicy": { "type": "object", "additionalProperties": false, "required": ["required", "video"], "properties": { "required": { "oneOf": [{ "const": ["trace", "screenshot", "video"] }, { "const": ["trace", "screenshot"] }] }, "video": { "enum": ["required", "blocked-cdp-production-context"] } } },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "globalErrorCount", "tests"],
      "properties": {
        "status": { "type": "string" },
        "globalErrorCount": { "type": "integer", "minimum": 0 },
        "tests": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/test" },
              {
                "type": "object", "required": ["outcome", "attempts"],
                "properties": {
                  "outcome": { "type": "string" },
                  "attempts": { "type": "array", "items": { "$ref": "#/$defs/attempt" } }
                }
              }
            ]
          }
        }
      }
    },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/hash" } } } },
    "blockedCapabilities": { "type": "array", "minItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["id", "status", "reason"], "properties": { "id": { "type": "string", "minLength": 1 }, "status": { "const": "blocked" }, "reason": { "type": "string", "minLength": 1 } } } },
    "wholeApplicationAcceptance": { "const": false },
    "scopedGate": { "enum": ["passed", "failed"] },
    "failures": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "retry", "duration", "errorCount", "attachments"],
      "properties": {
        "status": { "type": "string" },
        "retry": { "type": "integer", "minimum": 0 },
        "duration": { "type": "number", "minimum": 0 },
        "errorCount": { "type": "integer", "minimum": 0 },
        "attachments": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "contentType", "path"],
            "properties": {
              "name": { "type": "string" }, "contentType": { "type": "string" },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "test": { "type": "object", "required": ["id", "project", "file", "title", "expectedStatus", "repeatEachIndex", "annotations", "tags"], "properties": { "id": { "type": "string", "minLength": 1 }, "project": { "type": "string", "minLength": 1 }, "file": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "expectedStatus": { "type": "string" }, "repeatEachIndex": { "const": 0 }, "annotations": { "type": "array", "items": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string" }, "description": { "type": "string" } } } }, "tags": { "type": "array", "items": { "type": "string" } } } }
  }
}
